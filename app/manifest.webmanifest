{
  "name": "Hooman in the Loop",
  "short_name": "Hooman",
  "description": "The AI guesses. The hooman decides. Swipe to judge what a model found on your images, and draw to fix it.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0d1214",
  "theme_color": "#0d1214",
  "icons": [
    {"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [{"name": "deck", "accept": ["application/zip", "application/x-zip-compressed", ".zip", "application/json", ".json", "application/octet-stream"]}]
    }
  }
}
